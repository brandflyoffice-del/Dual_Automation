# Caddy gets and renews HTTPS certificates by itself (Let's Encrypt).
# APP_DOMAIN / N8N_DOMAIN / DASH_USER / DASH_PASS_HASH come from /opt/fenebris/.env (see deploy/docker-compose.prod.yml).

# *_OLD are the previous hostnames after a domain move (empty otherwise), so links that point at them keep working.
{$APP_DOMAIN} {$APP_DOMAIN_OLD} {
	encode zstd gzip

	# Login is handled by the dashboard itself (login page + signed session cookie, src/middleware.ts).

	# The n8n -> dashboard callbacks are internal (http://dashboard:3400), never through the internet.
	@internal path /api/webhooks/n8n /api/mail/*
	respond @internal 404

	reverse_proxy dashboard:3400 {
		# SSE (/api/events) must not be buffered
		flush_interval -1
	}
}

{$N8N_DOMAIN} {$N8N_DOMAIN_OLD} {
	encode zstd gzip
	reverse_proxy n8n:5678
}
