{
  "name": "fenebris-dashboard",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3400",
    "build": "prisma generate && next build",
    "start": "next start -p 3400",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "n8n:build": "node n8n/build-workflows.mjs",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "prisma db push --force-reset && tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "postinstall": "prisma generate",
    "n8n:push": "node n8n/push.mjs",
    "n8n:push:docker": "node n8n/push.mjs --docker n8nangravtity-n8n-1",
    "init:secrets": "node scripts/init-secrets.mjs",
    "deploy:init": "node scripts/prod-init.mjs",
    "deploy": "node scripts/deploy.mjs"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.16.0",
    "@tanstack/react-table": "^8.21.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "lucide-react": "^0.544.0",
    "next": "15.5.28",
    "radix-ui": "^1.4.3",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "recharts": "^2.15.4",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.3.1",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.5.28",
    "prisma": "^6.16.0",
    "tailwindcss": "^4",
    "tsx": "^4.20.5",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5"
  }
}
