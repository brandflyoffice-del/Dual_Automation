# ── Database (local docker: `npm run db:up`; production: Supabase connection string) ──
DATABASE_URL="postgresql://fenebris:fenebris@localhost:54329/fenebris?schema=public"

# ── Shared secret between n8n and this app (header: x-fenebris-secret) ──
WEBHOOK_SECRET="change-me-long-random-string"

# ── n8n instance (webhook base, no trailing slash) ──
N8N_BASE_URL="https://your-n8n.example.com"
# Workflow 1  → POST {N8N_BASE_URL}/webhook/fenebris-scraper-batch
# Workflow 2  → POST {N8N_BASE_URL}/webhook/fenebris-lead-control
# Workflow 3  → POST {N8N_BASE_URL}/webhook/fenebris-meeting-update

# ── Deep links shown in the UI ──
GOOGLE_SHEET_URL="https://docs.google.com/spreadsheets/d/REPLACE_WITH_SHEET_ID/edit"
GOOGLE_CALENDAR_URL="https://calendar.google.com/calendar/u/0/r"
BOOKING_LINK="https://cal.com/fenebris/discovery"

# ── Public URL of this dashboard (used for report share links) ──
NEXT_PUBLIC_APP_URL="http://localhost:3100"
